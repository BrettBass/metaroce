Description: qp_test calibrations for the emulated provider: a 10s
 completion wait in QpStateTest.PostRecvInit where the 2s default
 flakes, and retry_cnt 1 plus a 6s wait in
 ResponderQpStateTest.ResponderNotReadyToReceive, where the suite
 would otherwise wait out 5 futile retries. Without them these
 green-filtered tests fail or flake.
Category: timing-accommodation
Revisit-When: drop hunks if the suite's waits grow past these values
 or the provider gets faster; revisit if the green filter changes.

diff --git a/unit/qp_test.cc b/unit/qp_test.cc
--- a/unit/qp_test.cc
+++ b/unit/qp_test.cc
@@ -744,5 +744,6 @@
   ibv_send_wr send =
       verbs_util::CreateSendWr(/*wr_id=*/1, &lsge, /*num_sge=*/1);
   verbs_util::PostSend(setup.local_qp, send);
+  // Increase timeout to 10 to avoid flakiness.
   ASSERT_OK_AND_ASSIGN(ibv_wc completion,
-                       verbs_util::WaitForCompletion(setup.cq));
+                       verbs_util::WaitForCompletion(setup.cq, absl::Seconds(10)));
@@ -1127,4 +1128,4 @@
                                       QpAttribute()
                                           .set_timeout(absl::Seconds(1))
-                                          .set_retry_cnt(5)
+                                          .set_retry_cnt(1)
                                           .set_rnr_retry(5)));
@@ -1147,5 +1148,9 @@
     LOG(INFO) << "Provider does not buffer incoming messages. Expecting "
                  "unsuccessful completions.";
+    // Increase the timeout to 6 seconds to ensure that the all subsequent
+    // retry attempts fail.
+    // Also reduced the retry count to 1 to ensure that the retry attempts were made.
+    // If the retry count is increased, the test timeout needs to be increased
     ASSERT_OK_AND_ASSIGN(ibv_wc completion,
-                         verbs_util::WaitForCompletion(requestor.cq));
+                         verbs_util::WaitForCompletion(requestor.cq, absl::Seconds(6)));
     EXPECT_THAT(completion.status, AnyOf(IBV_WC_RETRY_EXC_ERR,
